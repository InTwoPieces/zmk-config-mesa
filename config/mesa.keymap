#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include "keys_de.h"

#define Base        0
#define Nav         1
#define Sym         2
#define Adjust      3
#define Fun         4
#define Umlaut      5
#define Game        6
#define Gameplus    7

&mt {
    quick-tap-ms = <175>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <175>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <240>;
            quick-tap-ms = <175>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
              &kp Q       &kp W       &kp E          &kp R         &kp T        &kp Y    &kp U        &kp I        &kp O       &kp P
              &hm LGUI A  &hm LALT S  &hm LCTRL D    &hm LSHIFT F  &kp G        &kp H    &hm RSHFT J  &hm RCTRL K  &hm RALT L  &hm RGUI DE_COLON
&lt 4 ESCAPE  &kp Z       &kp X       &kp C          &kp V         &kp B        &kp N    &kp M        &kp DE_COMMA    &kp DE_DOT     &kp DE_SLASH           &kp DE_APOSTROPHE
                                      &lt 5 DEL      &lt 1 TAB     &kp SPACE    &kp RET  &lt 2 BSPC   &kp DE_MINUS
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
              &kp TILDE       &trans        &kp UP_ARROW    &kp TAB    &kp DE_LBRC    &kp DE_RBRC  &kp NUMBER_7     &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
              &kp LGUI        &kp LEFT      &kp DOWN        &kp RIGHT     &kp DE_LBKT    &kp DE_RBKT  &kp NUMBER_4     &kp NUMBER_5  &kp NUMBER_6  &kp KP_MULTIPLY
&kp LEFT_ALT  &kp LCTRL       &kp DE_MINUS  &kp LEFT_SHIFT  &kp DE_PLUS   &kp DE_LPAR    &kp DE_RPAR  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp KP_DIVIDE  &kp KP_EQUAL
                                            &trans          &trans     &trans         &kp END      &lt 3 KP_COMMA   &kp DE_DOT
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
                &kp DE_EXCL  &kp DE_DQT &kp DE_SECT   &kp DE_DOLLAR  &kp DE_PERCENT    &kp DE_AMPS     &kp DE_SLASH   &kp DE_EQUAL   &kp DE_QMARK  &kp PLUS
                &kp DE_AT    &trans     &trans        &trans         &trans            &kp HASH        &kp BSLH       &trans         &trans        &kp SQT
&kp DE_CARET    &kp DE_LT    &kp DE_GT  &kp DE_PIPE   &trans         &trans            &kp DE_UNDER    &trans         &trans         &trans        &kp DE_SLASH  &kp HOME
                                        &trans        &mo 3          &trans            &trans          &trans         &trans
            >;
        };

        Adjust {
            display-name = "Adjust";
            bindings = <
                &trans    &trans  &trans    &trans      &out OUT_USB         &kp PSCRN  &kp F7      &kp F8    &kp F9   &kp F12
                &trans    &trans  &trans    &trans      &out OUT_BLE         &trans     &kp F4      &kp F5    &kp F6   &kp F11
&studio_unlock  &trans    &trans  &trans    &trans      &out OUT_TOG         &trans     &kp F1      &kp F2    &kp F3   &kp F10  &trans
                                  &trans    &trans      &trans               &trans     &trans      &trans
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
        &bootloader  &trans  &trans  &trans  &to 6     &trans  &trans  &trans  &trans   &trans
        &trans       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans
&trans  &trans       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans  &trans
                             &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        Umlaut {
            display-name = "Umlaut";
            bindings = <
        &trans           &trans     &kp DE_EURO  &trans  &trans    &trans  &kp DE_U_UMLAUT  &trans  &kp DE_O_UMLAUT   &trans
        &kp DE_A_UMLAUT  &kp DE_SZ  &trans       &trans  &trans    &trans  &trans           &trans  &trans            &trans
&trans  &trans           &trans     &trans       &trans  &trans    &trans  &kp DE_MU        &trans  &trans  &trans            &trans
                                    &trans       &trans  &trans    &trans  &trans  &trans
            >;
        };

        Gaming {
            display-name = "Game";
            bindings = <
            &kp Z           &kp Q  &kp W      &kp E         &kp R     &trans  &trans  &trans  &trans  &trans
            &kp TAB         &kp A  &kp S      &kp D         &kp F     &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &kp LEFT_SHIFT  &kp X  &kp C      &kp V         &sl 7     &trans  &trans  &trans  &trans  &trans  &trans
                                   &kp LCTRL  &kp LEFT_ALT  &kp SPACE    &trans  &trans  &trans
            >;
        };

        Gaming+ {
            display-name = "Game+";
            bindings = <
        &kp F10  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp T     &kp RA(RC(Y))  &kp RA(RC(U))  &trans  &trans  &kp LC(RA(DEL))
        &kp L    &kp O         &kp Y         &kp K         &kp G     &kp F5         &kp F7         &trans  &trans  &kp F12
&trans  &to 0    &trans        &trans        &trans        &trans    &trans         &trans         &trans  &trans  &kp F22          &kp LA(F4)
                               &kp J         &kp I         &kp M     &trans         &trans         &trans
            >;
        };
    };
};
